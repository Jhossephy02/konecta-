{
  "name": "conecta-portal-unificado",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "backup": "node --env-file-if-exists=.env server/backup.mjs",
    "provision-superadmin": "node --env-file-if-exists=.env server/provision.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "5.15.3",
    "@vitejs/plugin-react": "6.1.2",
    "nodemailer": "10.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
